## `r params$tX` vs `r params$tY`  `r params$pathway` `r params$direction`

```{r, out.width="100%", echo=FALSE}
fname=file.path(
  params$report_plots_folder_png,
  glue("`r params$prefix`{pathway}_{direction}_genes_heatmap_vs_{tX}.vs.{tY}_cluster-{params$cluster}.png")
)
if(file.exists(fname)) knitr::include_graphics(fname)
```


```{r, out.width="100%", echo=FALSE}
### {direction} genes top 10
flist = stringr::str_sort(grep(
  glue("`r params$prefix`top10-{pathway}{direction}_bar_vs_{tX}.vs.{tY}_cluster-{params$cluster}_p"),
  list.files(
    params$report_plots_folder_png,
    full.names=TRUE
  ),
  value=TRUE,
  fixed=TRUE
),numeric=TRUE)
if(length(flist) > 0) knitr::include_graphics(flist)

